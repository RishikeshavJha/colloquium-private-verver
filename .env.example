# ─────────────────────────────────────────────────────────────────────────────
# INSPIRE Colloquium 2026 — Environment Variables Reference
#
# Copy this file to .env.local for local development.
# .env.local is git-ignored and must NEVER be committed.
#
# For production, set all variables in Vercel Dashboard > Project > Settings > Environment Variables.
# Mark SERVER-ONLY variables as "Sensitive" in Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC VARIABLES (safe to expose to the browser — see Firebase docs)
# These are Firebase client-side identifiers. They are NOT secrets.
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY VARIABLES (must NEVER be prefixed with VITE_ — Vite exposes VITE_* to browser)
# Set these ONLY in Vercel server environment. Mark as Sensitive.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin SDK service account JSON (full JSON as single string, no line breaks)
# Generate from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# n8n webhook Bearer token (rotate immediately — old value your_n8n_bearer_secret_here is compromised)
# Set a strong random value (e.g. openssl rand -hex 32) and configure the same value
# in n8n Webhook nodes > Authentication > Bearer Token
N8N_WEBHOOK_SECRET=

# n8n webhook URLs (these are not secrets, but kept server-side to prevent direct browser calls)
N8N_REGISTRATION_WEBHOOK_URL=
N8N_SUBMISSION_UG_WEBHOOK_URL=
N8N_SUBMISSION_PG_WEBHOOK_URL=
N8N_PAYMENT_WEBHOOK_URL=

# Comma-separated list of allowed CORS origins for /api/* endpoints
# Include production URL and any preview deployment patterns
# Example: https://your-app.vercel.app,https://your-custom-domain.com
ALLOWED_ORIGINS=

# ─────────────────────────────────────────────────────────────────────────────
# INSPIRE Colloquium 2026 — Environment Variables Reference (Template)
#
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
#
# .env.local is git-ignored and must NEVER be committed.
#
# For production, set all variables in:
# Vercel Dashboard > Project > Settings > Environment Variables.
# Mark SERVER-ONLY variables as "Sensitive" in Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC VARIABLES (Safe for browser client bundle)
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY VARIABLES (NEVER prefix with VITE_)
# Set these ONLY in Vercel server environment. Mark as Sensitive.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin SDK service account JSON (full JSON as single string, no line breaks)
# Generate from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# n8n webhook Bearer token — set the SAME value in both Vercel AND n8n Webhook node > Authentication > Bearer Token
N8N_WEBHOOK_SECRET=your_n8n_bearer_secret_here

# n8n webhook URLs (kept server-side in api/webhook-proxy.ts to prevent browser exposure)
N8N_REGISTRATION_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/your-registration-webhook-id
N8N_SUBMISSION_UG_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/your-submission-ug-webhook-id
N8N_SUBMISSION_PG_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/your-submission-pg-webhook-id
N8N_PAYMENT_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/your-payment-webhook-id

# Comma-separated list of allowed CORS origins for /api/* endpoints
ALLOWED_ORIGINS=https://your-domain.vercel.app

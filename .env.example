# ─────────────────────────────────────────────────────────────────────────────
# INSPIRE Colloquium 2026 — Environment Variables Reference
#
# Copy this file to .env.local for local development.
# .env.local is git-ignored and must NEVER be committed.
#
# For production, set all variables in Vercel Dashboard > Project > Settings > Environment Variables.
# Mark SERVER-ONLY variables as "Sensitive" in Vercel.
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC VARIABLES (safe to expose to the browser — see Firebase docs)
# These are Firebase client-side identifiers. They are NOT secrets.
# ─────────────────────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=ieee-colloquium.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ieee-colloquium
VITE_FIREBASE_STORAGE_BUCKET=ieee-colloquium.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=914616555571
VITE_FIREBASE_APP_ID=1:914616555571:web:bbb428406970d9596a2b46
VITE_FIREBASE_MEASUREMENT_ID=G-XTXEM3XYLJ

# ─────────────────────────────────────────────────────────────────────────────
# SERVER-ONLY VARIABLES (must NEVER be prefixed with VITE_ — Vite exposes VITE_* to browser)
# Set these ONLY in Vercel server environment. Mark as Sensitive.
# ─────────────────────────────────────────────────────────────────────────────

# Firebase Admin SDK service account JSON (full JSON as single string, no line breaks)
# Generate from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# n8n webhook Bearer token — set the SAME value in both Vercel AND n8n Webhook node > Authentication > Bearer Token
N8N_WEBHOOK_SECRET=your_n8n_bearer_secret_here

# n8n webhook URLs (kept server-side to prevent direct browser calls)
N8N_REGISTRATION_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/your-registration-webhook-id
N8N_SUBMISSION_UG_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/your-submission-ug-webhook-id
N8N_SUBMISSION_PG_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/your-submission-pg-webhook-id
N8N_PAYMENT_WEBHOOK_URL=https://your-n8n-instance.cloud/webhook/your-payment-webhook-id

# Comma-separated list of allowed CORS origins for /api/* endpoints
ALLOWED_ORIGINS=https://colloquium-private-verver.vercel.app,https://inspire-colloquium-ieee-slrtce-2026.vercel.app
